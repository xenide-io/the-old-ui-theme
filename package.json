{
  "name": "@xenide-io/the-old-ui-theme",
  "version": "0.5.2",
  "description": "Props-driven React components and theme tokens inspired by classic interface design \u2014 optimized for Next.js apps and internal tools.",
  "author": "Xenide",
  "license": "MIT",
  "homepage": "https://github.com/xenide-io/the-old-ui-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenide-io/the-old-ui-theme.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "design-system",
    "theming"
  ],
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./src/app/globals.css",
    "./themes.css": "./src/styles/themes.css",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js",
      "default": "./dist/ui.mjs"
    },
    "./suite": {
      "types": "./dist/suite.d.ts",
      "import": "./dist/suite.mjs",
      "require": "./dist/suite.js",
      "default": "./dist/suite.mjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.mjs"
    }
  },
  "files": [
    "dist",
    "src/app/globals.css",
    "src/components/ui",
    "src/components/charts",
    "src/components/icons",
    "src/suite",
    "src/styles/themes.css",
    "src/styles/typography.css",
    "src/styles/suite-skin.css",
    "tailwind-preset.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup --entry.index src/index.ts --entry.ui src/components/ui/index.ts --entry.suite src/suite/index.ts --entry.tailwind-preset tailwind-preset.ts --format cjs,esm --dts --external react,react-dom,next,iconoir-react,motion --clean --tsconfig ./tsconfig.lib.json",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test --project=desktop-chromium --workers=1 && playwright test --project=mobile-chromium --workers=1",
    "check": "bun run typecheck && bun run test",
    "clean": "rm -rf .next out *.tsbuildinfo dist",
    "icons:check": "node scripts/sync-posthog-icons.mjs",
    "prepublishOnly": "bun run build:lib",
    "release": "bun run check && npm publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=16.2.7",
    "tailwindcss": "^3.4.0",
    "d3-scale": "^4.0.2",
    "iconoir-react": ">=7.11.1",
    "motion": ">=12"
  },
  "peerDependenciesMeta": {
    "d3-scale": {
      "optional": true
    },
    "iconoir-react": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "iconoir-react": "^7.11.1",
    "motion": "^12.43.0",
    "d3-scale": "^4.0.2",
    "jsdom": "^26.1.0",
    "next": "^16.3.0",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@blocknote/core": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
