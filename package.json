{
  "name": "@xenide-io/the-old-ui-theme",
  "version": "0.12.5",
  "description": "Props-driven React components and theme tokens inspired by classic interface design \u2014 optimized for Next.js apps and internal tools.",
  "author": "Xenide",
  "license": "MIT",
  "homepage": "https://github.com/xenide-io/the-old-ui-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenide-io/the-old-ui-theme.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "design-system",
    "theming"
  ],
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./src/app/globals.css",
    "./themes.css": "./src/styles/themes.css",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js",
      "default": "./dist/ui.mjs"
    },
    "./suite": {
      "types": "./dist/suite.d.ts",
      "import": "./dist/suite.mjs",
      "require": "./dist/suite.js",
      "default": "./dist/suite.mjs"
    },
    "./theme-boot": {
      "types": "./dist/theme-boot.d.ts",
      "import": "./dist/theme-boot.mjs",
      "require": "./dist/theme-boot.js",
      "default": "./dist/theme-boot.mjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.mjs"
    }
  },
  "files": [
    "docs",
    "dist",
    "public/fonts",
    "scripts",
    "src/app/globals.css",
    "src/components/ui",
    "src/components/icons",
    "src/suite",
    "src/styles/themes.css",
    "src/styles/typography.css",
    "src/styles/suite-skin.css",
    "tailwind-preset.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup --entry.index src/index.ts --entry.ui src/components/ui/index.ts --entry.suite src/suite/index.ts --entry.theme-boot src/suite/lib/theme-boot.ts --entry.tailwind-preset tailwind-preset.ts --format cjs,esm --dts --external react,react-dom,next,lucide-react,@tanstack/react-table,@radix-ui/react-dialog,@radix-ui/react-dropdown-menu,@radix-ui/react-popover --clean --tsconfig ./tsconfig.lib.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test --project=desktop-chromium --workers=1 && playwright test --project=mobile-chromium --workers=1",
    "check": "bun run typecheck && bun run lint && bun run test",
    "clean": "rm -rf .next out *.tsbuildinfo dist",
    "icons:check": "node scripts/sync-posthog-icons.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepublishOnly": "bun run build:lib && bun run package:smoke",
    "release": "bun run check && bun run build && bun run build:lib && bun run package:smoke && npm publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": ">=16.2.7",
    "tailwindcss": "^4.0.0",
    "lucide-react": ">=1.61.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^26.1.0",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.61.0",
    "react-colorful": "^5.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  }
}
